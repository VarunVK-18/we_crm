          "name": "trademarkNo",
          "label": "Trademark Application / Cert Number",
          "type": "text",
          "required": false,
          "validation": {
            "regex": "^[A-Za-z0-9/-]{3,30}$",
            "errorMessage": "3–30 characters, letters/numbers, / and - allowed"
          }
        },
        {
          "name": "dpiitRefNo",
          "label": "DPIIT Registration Number",
          "type": "text",
          "required": false,
          "validation": {
            "regex": "^DIPP[0-9]{3,10}$",
            "errorMessage": "Must start with DIPP followed by digits (e.g. DIPP123)"
          }
        },
        {
          "name": "isoCertNo",
          "label": "ISO Certificate Number",
          "type": "text",
          "required": false,
          "validation": {
            "regex": "^[A-Za-z0-9][A-Za-z0-9./-]{2,49}$",
            "errorMessage": "3–50 characters, alphanumeric with /, ., - allowed"
          }
        }
