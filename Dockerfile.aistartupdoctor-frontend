# Stage 1: Build the React Vite frontend application
FROM node:20-alpine as build
WORKDIR /app

# Copy package files and install dependencies
COPY AIStartupDoctor-main/frontend/package.json AIStartupDoctor-main/frontend/package-lock.json* ./
RUN npm install --legacy-peer-deps

# Copy the rest of the frontend source code
COPY AIStartupDoctor-main/frontend/ ./

# Set production environment variables for the build
ENV VITE_API_BASE_URL=https://aistartupdoctor.com/api
ENV VITE_FRONTEND_URL=https://aistartupdoctor.com
ENV VITE_CRM_URL=https://aistartupdoctor.com/crm/login

# Build the application
RUN npm run build

# Stage 2: Serve the app with Nginx
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
