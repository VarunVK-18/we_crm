# Stage 1: Build the Angular CRM application with /crm/ base href
FROM node:20-alpine as build
WORKDIR /app

# Copy package files and install dependencies
COPY webpage/package.json webpage/package-lock.json* ./
RUN npm install --legacy-peer-deps

# Copy the rest of the CRM frontend application source code
COPY webpage/ ./
RUN npm run build -- --configuration production --base-href /crm/

# Stage 2: Serve the app with Nginx
FROM nginx:alpine

COPY --from=build /app/dist/webpage/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
