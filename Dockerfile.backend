FROM node:22-slim
WORKDIR /app

# Install system dependencies for Puppeteer and Canvas
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    unzip \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY crm_backend/package.json crm_backend/package-lock.json* ./
RUN npm install

# Copy application files
COPY crm_backend/ ./

# Expose the backend port
EXPOSE 5001

# Start the server
CMD ["npm", "start"]
